# Host ports below match docker-compose.yml (postgres 5434, qdrant 6335, ollama 11435, redis 6380)
# for running `pnpm dev` on the host. Inside compose, use the service names and container ports.

# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Database (docker-compose defaults: postgres / postgres / hr_onboarding)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hr_onboarding
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hr_onboarding

# Who may sign in (comma-separated; at least one is required). Domains match any address at them.
ALLOWED_EMAIL_DOMAINS=
ALLOWED_EMAILS=

# Google OAuth — the callback handler lives at /auth/google/callback (server/routes), not under /api
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# JWT — required, at least 32 characters (e.g. `openssl rand -hex 32`); the server refuses to boot otherwise
JWT_SECRET=

# Encrypts the Google tokens stored in the database. Required, 64 hex characters (`openssl rand -hex 32`).
# Changing it later only means everyone signs in again.
TOKEN_ENCRYPTION_KEY=

# LLM used by the agents (email classifier, calendar event parser): ollama | groq
LLM_PROVIDER=ollama
# Per-request timeout in ms (default 120000; local models can be slow on first load)
LLM_TIMEOUT_MS=

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=phi3

# Groq (required only when LLM_PROVIDER=groq). Key: https://console.groq.com/keys, models: https://console.groq.com/docs/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ImageKit
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Qdrant Vector DB
QDRANT_URL=http://localhost:6335

# Redis for background tasks (BullMQ). Inside docker compose: redis://redis:6379
REDIS_URL=redis://localhost:6380

# all = one process does everything; web = HTTP only; worker = task workers + WhatsApp
APP_ROLE=all

# Time zone interview times are entered and shown in (IANA name)
TIME_ZONE=Asia/Kolkata

# Optional: the https address Google can reach this app on, for Google Calendar push notifications
# PUBLIC_BASE_URL=https://hr.example.com

# Pause between two emails in a bulk send (ms)
MAIL_SEND_INTERVAL_MS=200

# First retry delay of a failed background task (ms); later retries wait twice as long
TASK_RETRY_DELAY_MS=5000

# Puppeteer (for WhatsApp). Leave empty locally to use puppeteer's bundled Chromium.
PUPPETEER_EXECUTABLE_PATH=
